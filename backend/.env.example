# Database (user will provide the hosted PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/lubaga_hospital
SSL_DB=false

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRY=24h

# Admin Credentials (for seeding only)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lubaga.org
ADMIN_PHONE=0772123456
ADMIN_PASSWORD=admin123

# CORS allowed origins (comma separated)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
